{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "default",
      "inherits": "base",
      "displayName": "Clean build, warnings as errors",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "tidy",
      "inherits": "base",
      "displayName": "Build with clang-tidy inline",
      "binaryDir": "${sourceDir}/build-tidy",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "ENABLE_CLANG_TIDY": "ON",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "analyzer",
      "inherits": "base",
      "displayName": "Build with gcc -fanalyzer",
      "binaryDir": "${sourceDir}/build-analyzer",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "ENABLE_GCC_ANALYZER": "ON",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "sanitize",
      "inherits": "base",
      "displayName": "Host tests under ASan and UBSan",
      "binaryDir": "${sourceDir}/build-sanitize",
      "cacheVariables": { "ENABLE_SANITIZERS": "ON" }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "Host tests with coverage instrumentation",
      "binaryDir": "${sourceDir}/build-coverage",
      "cacheVariables": { "ENABLE_COVERAGE": "ON" }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "displayName": "libFuzzer targets (clang only)",
      "binaryDir": "${sourceDir}/build-fuzz",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "ENABLE_FUZZING": "ON",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "default",  "configurePreset": "default" },
    { "name": "tidy",     "configurePreset": "tidy" },
    { "name": "analyzer", "configurePreset": "analyzer" },
    { "name": "sanitize", "configurePreset": "sanitize" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "fuzz",     "configurePreset": "fuzz" }
  ],
  "testPresets": [
    { "name": "default",  "configurePreset": "default",  "output": { "outputOnFailure": true } },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": { "outputOnFailure": true },
      "environment": {
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1",
        "ASAN_OPTIONS": "detect_stack_use_after_return=1"
      }
    },
    { "name": "coverage", "configurePreset": "coverage", "output": { "outputOnFailure": true } }
  ]
}
